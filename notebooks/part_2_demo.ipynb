    "# Boat animation\n",
    "from matplotlib.animation import FuncAnimation\n",
    "from matplotlib.transforms import Affine2D\n",
    "from IPython.display import HTML\n",
    "\n",
    "\n",
    "# Gunnerus hull (L_pp = 33.9 m , B = 9.6 m)\n",
    "BOAT_IMG =\"../assets/gunnerus_topview.png\"\n",
    "# --- Sketch of the configuration: top view, bow up --------------------------\n",
    "LPP, BEAM = 33.9, 9.6                   # R/V Gunnerus main dimensions\n",
    "N, E = 20,10\n",
    "psi = np.pi/2\n",
    "\n",
    "\n",
    "def BoatTrajectoryAnimation(logs, title =\"Vessel trajectory\" , n_frames = 200, interval = 50):\n",
    "    \"\"\"Animate the vessel from a run_sim log (uses logs.t and logs.eta).\n",
    "    \"\"\"\n",
    "    \n",
    "    # Data Handling\n",
    "    t, eta = np.array(logs.t), np.array(logs.eta)\n",
    "    idx = np.linspace(0, len(t)-1, min(n_frames, len(t))).astype(int)\n",
    "    img = plt.imread(BOAT_IMG)\n",
    "\n",
    "    # Static figure\n",
    "    fig, ax = plt.subplots(figsize=(6.5, 6.5))\n",
    "    ax.plot(eta[:,1], eta[:,0])\n",
    "    trail, = ax.plot([],[],)\n",
    "    im = ax.imshow(img, zorder = 3)\n",
    "    info = ax.text(0.02, 0.97, \"\", transform=ax.transAxes, va=\"top\", family=\"monospace\")\n",
    "    pad = LPP                                                  # margin so the hull fits\n",
    "    ax.set_xlim(eta[:, 1].min() - pad, eta[:, 1].max() + pad)\n",
    "    ax.set_ylim(eta[:, 0].min() - pad, eta[:, 0].max() + pad)\n",
    "    ax.set_aspect(\"equal\"); ax.grid(True, alpha=0.3)\n",
    "    ax.set_xlabel(\"East [m]\"); ax.set_ylabel(\"North [m]\"); ax.set_title(title)\n",
    "\n",
    "    # --- 3. one frame ---\n",
    "    def update(k):\n",
    "        i = idx[k]\n",
    "        N, E, psi = eta[i, 0], eta[i, 1], eta[i, 5]\n",
    "        im.set_extent([E - BEAM/2, E + BEAM/2, N - LPP/2, N + LPP/2])\n",
    "        im.set_transform(Affine2D().rotate_around(E, N, -psi) + ax.transData)\n",
    "        trail.set_data(eta[:i + 1, 1], eta[:i + 1, 0])\n",
    "        info.set_text(f\"t = {t[i]:6.0f} s  |  ψ = {np.rad2deg(psi):6.1f} deg \\nN = {N:6.1f} m  |  E = {E:6.1f} m\")\n",
    "        return im, trail, info\n",
    "\n",
    "    # --- 4. animation ---\n",
    "    anim = FuncAnimation(fig, update, frames=len(idx), interval=interval)\n",
    "    plt.close(fig)\n",
    "    return HTML(anim.to_jshtml())\n",
    "\n"
   ]
